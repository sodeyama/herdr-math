{
  "schemaVersion": 1,
  "validCases": [
    {
      "id": "power-inline",
      "features": ["powers"],
      "formulas": [{ "latex": "E=mc^2", "display": false }],
      "expectedGlyphs": ["E", "m", "c", "2"]
    },
    {
      "id": "fraction-and-root",
      "features": ["fractions", "roots"],
      "formulas": [
        { "latex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}", "display": true },
        { "latex": "y=\\sqrt[3]{x}", "display": false }
      ],
      "expectedGlyphs": ["x", "b", "a", "c", "y", "3"]
    },
    {
      "id": "sum-and-integral",
      "features": ["sums", "integrals"],
      "formulas": [
        { "latex": "\\sum_{i=1}^{n} i=\\frac{n(n+1)}{2}", "display": true },
        { "latex": "\\int_{0}^{\\infty} e^{-x^2}\\,dx=\\frac{\\sqrt{\\pi}}{2}", "display": true }
      ],
      "expectedGlyphs": ["Σ", "i", "n", "∫", "∞", "π"]
    },
    {
      "id": "aligned-equations",
      "features": ["aligned", "multiline"],
      "formulas": [
        {
          "latex": "\\begin{aligned}\nf(x) &= x^2 + 2x + 1 \\\\\n     &= (x+1)^2\n\\end{aligned}",
          "display": true
        }
      ],
      "expectedGlyphs": ["f", "x", "2", "1"]
    },
    {
      "id": "matrix",
      "features": ["matrices"],
      "formulas": [
        {
          "latex": "A=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}",
          "display": true
        }
      ],
      "expectedGlyphs": ["A", "1", "2", "3", "4"]
    },
    {
      "id": "greek-letters",
      "features": ["greek"],
      "formulas": [
        { "latex": "\\alpha+\\beta=\\gamma", "display": false },
        { "latex": "\\Delta x\\cdot\\Delta p\\geq\\frac{\\hbar}{2}", "display": true }
      ],
      "expectedGlyphs": ["α", "β", "γ", "Δ", "ℏ"]
    },
    {
      "id": "unicode-math",
      "features": ["unicode"],
      "formulas": [{ "latex": "α + β ≤ γ ⇒ γ ≥ α", "display": true }],
      "expectedGlyphs": ["α", "β", "≤", "γ", "⇒", "≥"]
    },
    {
      "id": "multiline-gathered",
      "features": ["multiline"],
      "formulas": [
        {
          "latex": "\\begin{gathered}\na_1+a_2+a_3=s \\\\\na_1a_2a_3=p\n\\end{gathered}",
          "display": true
        }
      ],
      "expectedGlyphs": ["a", "1", "2", "3", "s", "p"]
    }
  ],
  "invalidCases": [
    {
      "id": "unknown-command",
      "formula": { "latex": "\\notARealCommand{private}", "display": true },
      "expectedError": "invalid_latex"
    },
    {
      "id": "unbalanced-group",
      "formula": { "latex": "\\frac{1}{2", "display": true },
      "expectedError": "invalid_latex"
    },
    {
      "id": "unclosed-environment",
      "formula": { "latex": "\\begin{matrix}1 & 2", "display": true },
      "expectedError": "invalid_latex"
    }
  ],
  "limitCases": [
    {
      "id": "formula-count",
      "kind": "formula_count",
      "formulaTemplate": "x_{n}",
      "count": 5001,
      "expectedError": "renderer_input_limit"
    },
    {
      "id": "formula-characters",
      "kind": "formula_characters",
      "character": "x",
      "characters": 80001,
      "expectedError": "renderer_input_limit"
    },
    {
      "id": "aggregate-characters",
      "kind": "aggregate_formula_characters",
      "character": "x",
      "formulaCharacters": 70000,
      "count": 30,
      "expectedError": "renderer_input_limit"
    }
  ],
  "faultCases": [
    {
      "id": "forced-timeout",
      "kind": "timeout",
      "delayMs": 8001,
      "expectedError": "renderer_timeout"
    }
  ],
  "securityCases": [
    {
      "id": "https-href",
      "formula": {
        "latex": "\\href{https://renderer-test.invalid/private}{x}",
        "display": false
      },
      "expectedError": "invalid_latex"
    },
    {
      "id": "remote-image",
      "formula": {
        "latex": "\\includegraphics{https://renderer-test.invalid/image.png}",
        "display": true
      },
      "expectedError": "invalid_latex"
    },
    {
      "id": "file-url",
      "formula": { "latex": "\\url{file:///synthetic/private/file}", "display": false },
      "expectedError": "invalid_latex"
    },
    {
      "id": "html-extension",
      "formula": { "latex": "\\htmlClass{remote}{x}", "display": false },
      "expectedError": "invalid_latex"
    }
  ]
}
