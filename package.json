{
  "name": "herdr-math",
  "version": "0.1.0",
  "description": "Render LaTeX from AI agent responses in a side pane.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "sodeyama",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodeyama/herdr-math.git"
  },
  "bugs": {
    "url": "https://github.com/sodeyama/herdr-math/issues"
  },
  "homepage": "https://github.com/sodeyama/herdr-math#readme",
  "keywords": [
    "herdr-plugin",
    "latex",
    "math",
    "terminal"
  ],
  "files": [
    "dist/",
    "herdr-plugin.toml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "format": "prettier --write package.json tsconfig.json tsconfig.build.json eslint.config.js \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json eslint.config.js \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src tests eslint.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
